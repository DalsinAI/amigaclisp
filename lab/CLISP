.KEY ARGS/F
.BRA {
.KET }
; AmigaCLISP: start CLISP, e.g. CLISP or CLISP myfile.lisp
; CLISP: is the AmigaCLISP folder (Install assigns it).
Stack 2000000
If NOT EXISTS CLISP:lispinit.mem
  Execute CLISP:MakeImage
EndIf
CLISP:lisp -B CLISP:full -M CLISP:lispinit.mem -Eterminal ISO-8859-1 -Epathname ISO-8859-1 {ARGS}
