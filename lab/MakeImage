; AmigaCLISP: save CLISP:lispinit.mem, the memory image CLISP starts from.
; It is made on the Amiga it runs on (about 15 s): CLISP does it
; on first start, or run Execute CLISP:MakeImage after an update.
Stack 2000000
Set clispcd "`CD`"
CD CLISP:full
Delete CLISP:lispinit.mem QUIET >NIL:
Echo "MakeImage: loading CLISP to save its image, please wait..."
CLISP:lisp -B "" -norc makeimage.lisp
CD "$clispcd"
UnSet clispcd
If EXISTS CLISP:full/lispinit.mem
  Rename CLISP:full/lispinit.mem CLISP:lispinit.mem
  Echo "MakeImage: CLISP:lispinit.mem saved"
Else
  Echo "MakeImage: no image saved"
EndIf
