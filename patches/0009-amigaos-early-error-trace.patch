diff -ru a/src/error.d b/src/error.d
--- a/src/error.d	2026-11-05 17:04:33.812148326 +0000
+++ b/src/error.d	2026-11-05 17:04:33.843140494 +0000
@@ -376,6 +376,20 @@
 local void prepare_error (condition_t errortype, const char* errorstring,
                           bool start_driver_p)
 { /* the common part of error(), check_value() &c */
+ #ifdef UNIX_AMIGAOS
+  if (getenv("CLISP_TRACE")) {
+    /* the message, then the object for each ~S/~A, STACK_0 first */
+    var uintL i, n = 0;
+    var const char* p;
+    fprintf(stderr,"[amiga trace] error: %s\n",errorstring);
+    for (p = errorstring; *p; p++)
+      if (p[0] == '~' && (p[1] == 'S' || p[1] == 'A')) n++;
+    for (i = 0; i < n && i < 4; i++) {
+      fprintf(stderr,"[amiga trace]   arg %lu: ",(unsigned long)i);
+      nobject_out(stderr,STACK_(i)); fprintf(stderr,"\n");
+    }
+  }
+ #endif
   begin_error(); /* start error message */
   if (!nullp(STACK_3)) { /* *ERROR-HANDLER* = NIL, SYS::*USE-CLCS* /= NIL ? */
     /* choose error-type-symbol for errortype: */
diff -ru a/src/errunix.d b/src/errunix.d
--- a/src/errunix.d	2026-11-05 17:04:33.816072714 +0000
+++ b/src/errunix.d	2026-11-05 17:04:33.818356346 +0000
@@ -53,6 +53,10 @@
   errcode = errno;
   errno = 0; /* reset for the next error */
   end_system_call();
+ #ifdef UNIX_AMIGAOS
+  if (getenv("CLISP_TRACE"))
+    fprintf(stderr,"[amiga trace] OS_error errno=%d\n",errcode);
+ #endif
   clr_break_sem_4(); /* no UNIX operation may be active */
   pushSTACK(L_to_I(errcode));
   begin_error(); /* start error message */
