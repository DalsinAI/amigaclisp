--- a/src/lispbibl.d
+++ b/src/lispbibl.d
@@ -6130,6 +6130,13 @@
   #undef varobject_alignment
   #define varobject_alignment  4
 #endif
+#if defined(UNIX_AMIGAOS) && defined(WIDE_SOFT) && (varobject_alignment < 8)
+  /* AmigaOS: 64-bit objects on the 68k (whose gcc aligns them only to 2):
+     keep varobjects 8-aligned, as on the 64-bit and GENERATIONAL_GC WIDE
+     platforms where WIDE objects are tested. */
+  #undef varobject_alignment
+  #define varobject_alignment  8
+#endif
 #if ((defined(GENERATIONAL_GC) && defined(WIDE)) || defined(KERNELVOID32_HEAPCODES) || defined(GENERIC64_HEAPCODES)) && (varobject_alignment < 8)
   #undef varobject_alignment
   #define varobject_alignment  8
@@ -9476,7 +9483,10 @@
   /* If necessary, add fillers here to ensure sizeof(subr_t)
      is a multiple of varobject_alignment. */
 } subr_t
-#if defined(GENERIC64_HEAPCODES) && (alignment_long < 8) && defined(GNU)
+#if defined(UNIX_AMIGAOS) && defined(WIDE_SOFT) && defined(GNU)
+/* AmigaOS: Subrs are varobjects, 8-aligned like the rest (see above). */
+  __attribute__ ((aligned (8)))
+#elif defined(GENERIC64_HEAPCODES) && (alignment_long < 8) && defined(GNU)
 /* Force all Subrs to be allocated with a 8-byte alignment. GC needs this. */
   __attribute__ ((aligned (8)))
 #elif defined(HEAPCODES) && (alignment_long < 4) && defined(GNU)
