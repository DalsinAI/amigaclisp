diff -ru a/src/spvw_gcmark.d b/src/spvw_gcmark.d
--- a/src/spvw_gcmark.d	2026-11-05 17:32:10.853289707 +0000
+++ b/src/spvw_gcmark.d	2026-11-05 17:32:21.649943932 +0000
@@ -1,5 +1,23 @@
 /* Recursive marking routine. */
 
+#ifdef UNIX_AMIGAOS
+  /* say which word was not an object before giving up */
+  #if defined(KERNELVOID32_HEAPCODES)
+    #define AMIGA_GC_MODEL "KERNELVOID32_HEAPCODES"
+  #elif defined(ONE_FREE_BIT_HEAPCODES)
+    #define AMIGA_GC_MODEL "ONE_FREE_BIT_HEAPCODES"
+  #elif defined(TYPECODES)
+    #define AMIGA_GC_MODEL "TYPECODES"
+  #else
+    #define AMIGA_GC_MODEL "other"
+  #endif
+  #define gc_mark_bad(c,p)  \
+    (fprintf(stderr,"[amiga gc] gc_mark (%s, varobject_alignment %d): no object: curr=0x%08lx pred=0x%08lx\n", \
+             AMIGA_GC_MODEL,(int)varobject_alignment,(unsigned long)as_oint(c),(unsigned long)as_oint(p)), abort())
+#else
+  #define gc_mark_bad(c,p)  abort()
+#endif
+
 local void gc_mark (object obj)
 {
   var object curr = obj; /* current object */
@@ -259,7 +277,7 @@
       /* These are direct objects, no pointers. */
       goto up;
     default: /* These are no objects. */
-      /*NOTREACHED*/ abort();
+      /*NOTREACHED*/ gc_mark_bad(curr,pred);
   }
  #else
   switch (as_oint(curr) & nonimmediate_heapcode_mask) {
@@ -333,7 +351,7 @@
       /* These are direct objects, no pointers. */
       goto up;
     default:
-      /*NOTREACHED*/ abort();
+      /*NOTREACHED*/ gc_mark_bad(curr,pred);
   }
  #endif
  up: /* entry for ascent.
@@ -411,7 +429,7 @@
       case_lfloat: /* long-float */
         /* Objects of variable length, that do not contain pointers. */
       default: /* these are no objects. */
-        /*NOTREACHED*/ abort();
+        /*NOTREACHED*/ gc_mark_bad(curr,pred);
     }
    #else
     switch (as_oint(pred) & nonimmediate_heapcode_mask) {
@@ -426,7 +444,7 @@
         up_subr();
       #endif
       default: /* these are no objects. */
-        /*NOTREACHED*/ abort();
+        /*NOTREACHED*/ gc_mark_bad(curr,pred);
     }
    #endif
   }
